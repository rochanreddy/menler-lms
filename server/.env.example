# ── Menler LMS backend ──
PORT=4100

# SAME Atlas cluster as the marketing site. This service only touches lms_*
# collections, so it never collides with leads/orders/users.
# Copy the exact MONGODB_URI you use for the marketing backend.
MONGODB_URI=mongodb://127.0.0.1:27017/meridian

# Secret for signing LMS Bearer tokens — set to a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Single active session — how hard "one device at a time" bites.
#   warn   (default) a sign-in while the account is live elsewhere is refused
#          with "This account is currently being used on another device", and
#          the user is offered the takeover.
#   strict the newest sign-in always wins, no prompt.
#   off    sessions are still recorded (device list, video lock) but an older
#          one is never revoked.
# Only-one-device-may-WATCH is enforced in every mode.
LMS_SINGLE_SESSION=warn

# Base URL of the LMS frontend (for CORS + password-reset links).
LMS_APP_URL=http://localhost:5174

# Optional first-admin credentials for the seed script.
LMS_SEED_EMAIL=admin@menler.in
LMS_SEED_PASSWORD=ChangeMe123!

# ── Email ──
# Every mail (account credentials, admin password resets, forgot-password
# links) goes out through ONE of these. Resend is tried first, then SMTP;
# with neither set the message is printed to the server console instead.
#
# Resend (resend.com) — free tier is 100 emails/day, 3,000/month, which is
# plenty for admin-provisioned accounts. A "sending access" key is enough.
# MAIL_FROM must be on a domain verified in THIS Resend account (Domains →
# Add domain, then the DNS records it gives you). Until one is verified,
# leave MAIL_FROM unset: it falls back to onboarding@resend.dev, which Resend
# only delivers to the address that owns the account — fine for a test.
RESEND_API_KEY=
MAIL_FROM=

# SMTP email (until set, reset links log to the console). Works with Gmail
# (app password), SendGrid, Mailgun, Zoho, etc. Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Menler LMS <no-reply@menler.in>

# Google Drive API key (public-data only, no OAuth) — used to verify a
# student's submitted Drive folder is public and inspect its contents.
# Create one at console.cloud.google.com → APIs & Services → Credentials,
# restricted to the Drive API. Until set, Drive-link submissions come back
# CHECK_FAILED instead of being verified.
GOOGLE_DRIVE_API_KEY=

# OpenRouter — powers the automated submission review (utils/aiGrade.js).
# Get a key at openrouter.ai/keys. Until set, POST /submissions/:id/ai-review
# returns a configuration error; nothing else in the app is affected.
OPENROUTER_API_KEY=

# Which model reviews submissions — all three stages (write-up, screenshots,
# aggregator) run on this one. Any OpenRouter model that supports both
# structured outputs and (for the screenshot stage) image input will work.
# OPENROUTER_VISION_MODEL is only needed if you want the screenshot stage on a
# different model than the two text stages; it defaults to OPENROUTER_MODEL.
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_VISION_MODEL=

# VdoCipher — DRM-hosted playback for class recordings (upload + OTP API).
# Get the "Client Secret Key" at dashboard.vdocipher.com → Settings → API.
# Until set, recording upload/playback return a configuration error; nothing
# else in the app is affected (plain recordingUrl links keep working).
VDOCIPHER_API_SECRET=

# Zoom webhook attendance — the "Secret Token" from your Zoom app (Marketplace →
# your app → Feature → Event Subscriptions). Set the webhook URL there to
# https://<your-lms-api>/api/lms/zoom/webhook and subscribe to
# "Meeting → Participant/Host joined meeting". Until set, attendance falls back
# to click-to-join + manual marking.
ZOOM_WEBHOOK_SECRET_TOKEN=
